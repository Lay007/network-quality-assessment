[Unit]
Description=Server SFP SLA traffic measurement service
Wants=network-online.target
After=local-fs.target network-online.target mysql.service mariadb.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/server-sfp-sla
ExecStart=/usr/local/bin/Server_SFP_SLA
Restart=on-failure
RestartSec=1
TimeoutSec=5
LimitNOFILE=1617596
LimitNOFILESoft=1617596
NonBlocking=true

[Install]
WantedBy=multi-user.target
