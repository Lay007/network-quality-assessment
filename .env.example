# Database account used by the Go service and PHP web console.
SFP_SLA_DB_USER=sfp_user
SFP_SLA_DB_PASSWORD=<change-me>
SFP_SLA_DB_NAME=server_sfp_sla

# Leave empty for the local MySQL socket. Use host:port for TCP.
# Example: SFP_SLA_DB_ADDR=127.0.0.1:3306
SFP_SLA_DB_ADDR=

# PHP fallback values when SFP_SLA_DB_ADDR is empty.
SFP_SLA_DB_HOST=localhost
SFP_SLA_DB_PORT=
SFP_SLA_TIMEZONE=UTC

# Used by installation scripts only.
MYSQL_ROOT_PASSWORD=<mysql-root-password>
